{
  "name": "university-system",
  "version": "2.0.0",
  "description": "Ethiopia Holy Trinity Theology University (HTTU) - University Management System",
  "scripts": {
    "client": "cd client && npm run dev",
    "server": "cd server && node server.js",
    "server:dev": "cd server && nodemon server.js",
    "test:api": "node server/test/api.test.js",
    "dev": "concurrently \"npm run server\" \"npm run client\" --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\"",
    "install:all": "cd client && npm install && cd ../server && npm install",
    "build": "cd client && npm run build"
  },
  "keywords": [
    "httu",
    "theology",
    "orthodox",
    "university-management"
  ],
  "author": "Ethiopia Holy Trinity Theology University",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
